PORT=5001
# For local development: mongodb://localhost:27017/projectforge
# For cloud deployment (Atlas): mongodb+srv://<username>:<password>@cluster0.mongodb.net/projectforge?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/projectforge
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# AI Service Configuration ('local' requires no API key; 'openai' uses OpenAI)
AI_PROVIDER=local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_RATE_LIMIT_PER_MINUTE=30

